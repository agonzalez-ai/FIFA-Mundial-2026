# Copia este archivo a .env y rellena tu clave real. El .env NO se versiona.

# Clave de API-Football (API-Sports). Se lee de process.env.APIFOOTBALL_KEY.
APIFOOTBALL_KEY=

# Modo de autenticacion: "apisports" (directo, header x-apisports-key)
#   o "rapidapi" (via RapidAPI, header x-rapidapi-key). Default: apisports.
APIFOOTBALL_AUTH_MODE=apisports
